# Receipt time on the Nano. wt102_link is installed level, +Z up.
std_msgs/Header header
# Changes when the serial stream is reopened, discarded, or its clock jumps.
uint64 stream_id
uint8 YAW_RATE=1
uint8 RELATIVE_YAW=2
uint8 kind
# Calibrated body Z rate in rad/s or power-on-relative yaw in rad.
float64 value
