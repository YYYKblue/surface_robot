#!/usr/bin/env python3
"""Only publishes synthetic scans on /pool_cleaning/demo_scan."""
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import LaserScan
from f1_pool_cleaning.synthetic import pool_scan
from f1_pool_cleaning.ros_support import stamp
from f1_pool_cleaning.runner import run


class DemoScan(Node):
    def __init__(self):
        super().__init__("pool_demo_scan")
        self.pub = self.create_publisher(LaserScan, "/pool_cleaning/demo_scan", qos_profile_sensor_data)
        self.timer = self.create_timer(.05, self.publish)

    def publish(self):
        scan = pool_scan(self.get_clock().now().nanoseconds)
        message = LaserScan()
        message.header.stamp, message.header.frame_id = stamp(scan.stamp_ns), scan.frame
        message.angle_min, message.angle_increment = scan.angle_min, scan.angle_increment
        message.angle_max = scan.angle_min + (len(scan.ranges) - 1) * scan.angle_increment
        message.range_min, message.range_max = scan.range_min, scan.range_max
        message.ranges = list(scan.ranges)
        self.pub.publish(message)


if __name__ == "__main__":
    run(DemoScan)
